{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NEXUS",
  "version": "0.1.0",
  "identifier": "com.nexus.assistant",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../frontend run dev",
    "beforeBuildCommand": "npm --prefix frontend run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "NEXUS",
        "width": 200,
        "height": 200,
        "minWidth": 200,
        "minHeight": 200,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "focus": true,
        "visible": false,
        "fullscreen": false,
        "hiddenTitle": true,
        "tabbingIdentifier": null,
        "dragDropEnabled": false,
        "url": "index.html"
      },
      {
        "label": "setup",
        "title": "NEXUS Setup",
        "width": 520,
        "height": 680,
        "resizable": false,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "shadow": true,
        "focus": true,
        "visible": false,
        "fullscreen": false,
        "center": true,
        "url": "setup.html"
      },
      {
        "label": "settings",
        "title": "NEXUS Settings",
        "width": 600,
        "height": 720,
        "resizable": false,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "shadow": true,
        "focus": true,
        "visible": false,
        "fullscreen": false,
        "center": true,
        "url": "settings.html"
      },
      {
        "label": "sidebar",
        "title": "NEXUS Response",
        "width": 280,
        "height": 500,
        "minWidth": 280,
        "minHeight": 500,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "focus": false,
        "visible": false,
        "fullscreen": false,
        "hiddenTitle": true,
        "tabbingIdentifier": null,
        "dragDropEnabled": false,
        "url": "sidebar.html"
      }
    ],
    "trayIcon": {
      "iconPath": "icons/tray.png",
      "iconAsTemplate": true,
      "menuOnLeftClick": false,
      "id": "NEXUS-tray"
    },
    "security": {
      "csp": "default-src 'self'; connect-src 'self' wss: https: ipc: http://ipc.localhost; media-src 'self' blob: data:; img-src 'self' data: blob:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data:",
      "capabilities": ["main-cap"],
      "assetProtocol": { "enable": false }
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/porcupine/*",
      "resources/sherpa/kws/*",
      "resources/sherpa/speaker_model.onnx",
      "resources/sherpa/silero_vad.onnx"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "template": "installer/nexus-installer.nsi",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "compression": "lzma",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "macOS": {
      "signingIdentity": "Developer ID Application: YOUR_TEAM",
      "providerShortName": "NEXUS",
      "entitlements": "entitlements.plist",
      "infoPlist": "Info.plist"
    },
    "linux": {
      "appimage": { "bundleMediaFramework": true }
    },
    "copyright": "© 2026 NEXUS",
    "category": "Productivity",
    "shortDescription": "Floating desktop AI assistant (thin client)",
    "longDescription": "A cross-platform floating AI assistant that bridges to a remote n8n/Ollama backend."
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["nexus"]
      }
    }
  }
}
