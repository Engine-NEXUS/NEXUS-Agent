# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Source files ΓÇö always LF (required for macOS/Linux builds)
*.rs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.py text eol=lf
*.html text eol=lf
*.css text eol=lf
*.sh text eol=lf
*.plist text eol=lf
*.entitlements text eol=lf

# Windows-specific files ΓÇö CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.nsi text eol=crlf

# Binary files ΓÇö no line ending conversion
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.icns binary
*.bmp binary
*.onnx binary
*.bin binary
*.wav binary
*.mp3 binary
*.woff binary
*.woff2 binary
