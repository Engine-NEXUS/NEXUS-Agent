# Ultron Sidecar Environment Variables
# Copy this file to .env and fill in your values.

# ---- STT (faster-whisper) ----
STT_URL=http://localhost:8000/transcribe

# ---- n8n ----
N8N_SUPERVISOR_URL=http://localhost:5678/webhook/supervisor
N8N_STREAM_URL=http://localhost:5678/webhook-stream/supervisor
N8N_API_TOKEN=

# ---- ElevenLabs TTS ----
# Get these from https://elevenlabs.io
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5

# ---- Google OAuth ----
# Create at https://console.cloud.google.com/apis/credentials
# Application type: Web application (the sidecar exchanges the code)
# Redirect URI: ultron://oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- GitHub OAuth ----
# Create at https://github.com/settings/developers → OAuth Apps → New OAuth App
# Authorization callback URL: ultron://oauth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- OAuth Redirect ----
# Must match what's registered in Google Cloud Console and GitHub OAuth App
OAUTH_REDIRECT_URI=ultron://oauth/callback

# ---- Security ----
# Optional bearer gate on the /ws WebSocket endpoint
ULTRON_SIDECAR_TOKEN=
# Fernet encryption key for API keys at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ULTRON_ENCRYPTION_KEY=

# ---- Database ----
ULTRON_DB_PATH=ultron_credentials.db

# ---- Server ----
SIDECAR_HOST=0.0.0.0
SIDECAR_PORT=8443
